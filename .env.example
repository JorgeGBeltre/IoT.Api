# ==============================================================================
# IoT SaaS Platform — Backend Environment Configuration Template (.env.example)
# ==============================================================================
# Copia este archivo a IoT.Api/.env y reemplaza los valores de seguridad antes
# de ejecutar 'docker compose up -d'.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS GEOGRÁFICA (POSTGRESQL 16 + POSTGIS 3.4)
# ------------------------------------------------------------------------------
POSTGRES_DB=iot_platform_db
POSTGRES_USER=iot_admin
POSTGRES_PASSWORD=__CAMBIAR_PASSWORD_POSTGRES_PRODUCCION__
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. CACHÉ, SESIONES Y ESTADO EN TIEMPO REAL (REDIS 7)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=__CAMBIAR_PASSWORD_REDIS_PRODUCCION__
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. SEGURIDAD, AUTENTICACIÓN Y TOKENS JWT
# ------------------------------------------------------------------------------
# Clave HMAC-SHA256 de al menos 32 caracteres criptográficamente seguros
JWT_SECRET=__CAMBIAR_JWT_SECRET_MINIMO_32_CARACTERES_ALEATORIOS__
JWT_ISSUER=IoT-SaaS-Platform
JWT_AUDIENCE=IoT-Frontend

# Contraseña inicial de los administradores sembrados. OBLIGATORIA en producción:
# si falta, el API NO arranca (no se autogenera ni se loguea ningún secreto). Se exige
# cambiarla en el primer inicio de sesión.
SEED_ADMIN_PASSWORD=__CAMBIAR_PASSWORD_ADMIN_INICIAL__

# Origen del frontend (scheme+host[:port]) para la política CORS. OBLIGATORIO en prod
# (sin él, el navegador bloquea el login con credenciales). Y host(s) permitido(s) del API.
FRONTEND_ORIGIN=https://app.tu-dominio.com
ALLOWED_HOSTS=api.tu-dominio.com

# ------------------------------------------------------------------------------
# 4. BROKER MQTT EMBEBIDO & PUERTOS
# ------------------------------------------------------------------------------
# El broker MQTT corre EMBEBIDO en iot-api (no hay Mosquitto). Cada dispositivo se
# autentica con su PROPIA ApiKey (se genera/rota desde la UI; MQTT 5: UserProperty
# 'ApiKey' + 'ChipId'; 3.1.1: Username=ApiKey, ClientId=ChipId). MQTT_API_KEY es la
# clave global de bootstrap (p.ej. para el simulador); los dispositivos reales usan
# su ApiKey por equipo. MQTT_PUBLIC_HOST es el host/dominio que se muestra al operador.
MQTT_PORT=1883
MQTT_API_KEY=__CAMBIAR_APIKEY_BOOTSTRAP_MQTT__
MQTT_PUBLIC_HOST=localhost
MQTT_TLS=false

# ------------------------------------------------------------------------------
# 5. GATEWAY TCP BINARIO (SEEWORLD R12L-F)
# ------------------------------------------------------------------------------
TCP_GATEWAY_PORT=5023

# ------------------------------------------------------------------------------
# 6. SERVICIO DE CORREO ELECTRÓNICO (MAILKIT SMTP OTP)
# ------------------------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@tu-dominio.com
SMTP_PASSWORD=__CAMBIAR_PASSWORD_APLICACION_SMTP__
SMTP_SENDER_NAME=IoT SaaS Caribe
SMTP_ENABLE_SSL=true

# ------------------------------------------------------------------------------
# 7. PUERTO HOST DEL API REST & SIGNALR
# ------------------------------------------------------------------------------
API_PORT=5000
