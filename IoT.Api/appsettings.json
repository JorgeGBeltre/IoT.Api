{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "ExternalSubscriptionEnabled": false
  },
  "MqttBroker": {
    "Port": 1883,
    "PublicHost": "localhost",
    "Tls": false,
    "AllowAnonymous": false,
    "ApiKeys": []
  },
  "TcpGateway": {
    "Enabled": true,
    "Port": 5023,
    "MaxConnections": 5000,
    "IdleTimeoutSeconds": 300,
    "Listeners": [
      { "Protocol": "GT06", "Port": 5023 },
      { "Protocol": "Mictrack", "Port": 5024 },
      { "Protocol": "Queclink", "Port": 5027 },
      { "Protocol": "Coban", "Port": 5013 },
      { "Protocol": "iStartek", "Port": 5001 },
      { "Protocol": "Jointech", "Port": 5002 }
    ]
  },
  "Authorization": {
    "FirmwareManageRoles": [ "Admin" ]
  },
  "Seed": {
    "AdminPassword": ""
  },
  "Jwt": {
    "Issuer": "IoT-SaaS-Platform",
    "Audience": "IoT-Frontend",
    "ExpirationHours": 2
  }
}
